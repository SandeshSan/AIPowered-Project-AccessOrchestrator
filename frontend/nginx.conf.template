server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # API calls proxy to the backend Cloud Run service.
    # $proxy_host is critical here so Google Cloud Run's front proxy recognizes the target host.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_server_name on;

        # Assistant turns can involve several LLM round trips
        proxy_read_timeout 180s;
        proxy_connect_timeout 60s;
        proxy_send_timeout 180s;
    }

    # Hashed build assets can be cached for good
    location ~* \.(?:js|css|woff2?|ttf|svg|png|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Angular routes (/login, /team, ...) all load index.html, which must never be cached stale
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
